{
  "name": "civ6-mod-toolkit",
  "version": "1.9.3",
  "private": true,
  "description": "Civilization VI mod toolkit: edit mods in .Civ6Cfg game configurations and see which mods are enabled.",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "phase0": "node src/phase0-roundtrip.js",
    "phase1": "node src/phase1-inventory.js",
    "phase2": "node src/phase2-save.js",
    "test:profiles": "node --test tests/profiles.test.js",
    "test:labels": "node --test tests/labels.test.js",
    "test:sorting": "node --test tests/sorting.test.js",
    "test:loadorder": "node --test tests/loadorder.test.js",
    "test:scripts": "node --test tests/browser-scripts.test.js",
    "test:replay": "node --test tests/conflict-replay.test.js",
    "test:shadowing": "node --test tests/shadowing.test.js",
    "test:packaging": "node --test tests/packaging.test.js",
    "phase9-selfcheck": "node src/server.js --selfcheck",
    "test:game-setup": "node --test tests/game-setup.test.js",
    "test:config-scan": "node --test tests/config-scan.test.js",
    "test:play-save": "node --test tests/play-save.test.js",
    "test:tuner": "node --test tests/tuner.test.js",
    "test:leader-escape": "node --test tests/leader-escape.test.js",
    "phaseclean": "node src/phase-clean.js",
    "check:release": "npm run test:profiles && npm run test:labels && npm run test:sorting && npm run test:loadorder && npm run test:scripts && npm run test:replay && npm run test:shadowing && npm run test:packaging && npm run test:tuner && npm run phase9-selfcheck && npm run test:game-setup && npm run test:config-scan && npm run test:play-save && npm run phaseclean && npm run lint:comments",
    "edit": "node src/edit-config.js",
    "lint:comments": "eslint src public"
  },
  "author": "cru121 (Steam: evzenhouzvicka), maintained by Klear2012",
  "repository": "github:Klear2012/Civ6-Mod-Toolkit",
  "license": "MIT",
  "dependencies": {
    "buffer-v6-polyfill": "^1.0.5",
    "diacritics": "^1.3.0",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-legibility": "0.4.0",
    "eslint-plugin-no-comment-slop": "0.6.0"
  }
}
