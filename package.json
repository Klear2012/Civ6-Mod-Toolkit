{
  "name": "civ6-mod-toolkit",
  "version": "1.9.1",
  "private": true,
  "description": "Civilization VI mod toolkit: edit mods in .Civ6Cfg game configurations and see which mods are enabled.",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "phase0": "node src/phase0-roundtrip.js",
    "phase1": "node src/phase1-inventory.js",
    "phase2": "node src/phase2-save.js",
    "phase4": "node src/phase4-profiles.js",
    "test:labels": "node --test tests/labels.test.js",
    "test:sorting": "node --test tests/sorting.test.js",
    "phase7": "node src/phase7-loadorder.js",
    "phase8": "node src/phase8-scripts.js",
    "phase9-replay": "node src/phase9-conflict-replay.js --envelope && node src/phase9-conflict-replay.js --text-tables",
    "phase9-shadowing": "node src/phase9-shadowing.js --envelope",
    "phase10-packaging": "node src/phase10-packaging.js",
    "phase9-selfcheck": "node src/server.js --selfcheck",
    "test:game-setup": "node --test tests/game-setup.test.js",
    "phaseclean": "node src/phase-clean.js",
    "check:release": "npm run phase4 && npm run test:labels && npm run test:sorting && npm run phase7 && npm run phase8 && npm run phase9-replay && npm run phase9-shadowing && npm run phase10-packaging && npm run phase9-selfcheck && npm run test:game-setup && npm run phaseclean",
    "edit": "node src/edit-config.js"
  },
  "author": "cru121 (Steam: evzenhouzvicka), maintained by Klear2012",
  "repository": "github:Klear2012/Civ6-Mod-Toolkit",
  "license": "MIT",
  "dependencies": {
    "buffer-v6-polyfill": "^1.0.5",
    "diacritics": "^1.3.0",
    "iconv-lite": "^0.6.3",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8"
  }
}
